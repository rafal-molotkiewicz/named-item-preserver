{
	"schemaVersion": 1,
	"id": "named-item-preserver",
	"version": "0.1.3",
	"name": "Named Item Preserver",
	"description": "Prevents named items from despawning and logs their lifecycle. Spills named contents from unnamed containers. Server-side Fabric mod for Minecraft 26.1.2.",
	"authors": [
		"molot"
	],
	"contact": {
		"homepage": "https://github.com/molot-eu/named-item-preserver",
		"sources": "https://github.com/molot-eu/named-item-preserver"
	},
	"license": "Charity",
	"icon": "assets/named-item-preserver/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"pl.molot.nip.NamedItemPreserver"
		],
		"client": [
			"pl.molot.nip.NamedItemPreserverClient"
		],
		"fabric-datagen": [
			"pl.molot.nip.NamedItemPreserverDataGenerator"
		]
	},
	"mixins": [
		"named-item-preserver.mixins.json",
		{
			"config": "named-item-preserver.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1.2",
		"java": ">=21",
		"fabric-api": "*"
	}
}